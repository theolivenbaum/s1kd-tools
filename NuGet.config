<?xml version="1.0" encoding="utf-8"?>
<!--
  nuget.org, plus a folder for packages that are not on it yet.

  The editor's page preview renders with Tesserae.Pdf
  (https://github.com/curiosity-ai/tesserae-pdf), which is not published at the
  time of writing. `samples/editor/pack-tesserae-pdf.sh` clones and packs it into
  .localfeed so `dotnet build S1kdTools.Editor.slnx` works from a fresh clone.

  A local source that does not exist is not an error - NuGet treats it as an empty
  one - so this file costs nothing on a machine that has never run that script, and
  nothing at all once the package reaches nuget.org.

  Only the Transpose half of the repository needs any of this. S1kdTools.slnx -
  the library, the CLI, the tests and the editor back-end - restores from nuget.org
  alone.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="local" value=".localfeed" />
  </packageSources>
</configuration>
