    <checkList>
      <para>Complete this check list after the installation of a slat actuation power control unit
        and before the aircraft is released to service. An item that cannot be signed off makes the
        aircraft unserviceable.</para>
      <checkListInfo>
        <title>Post-installation check list</title>
        <checkListItems>
          <checkListItem>
            <para>Attachment bolts installed, tightened and lockwired.</para>
            <checkListItemLimits>Torque 48 Nm to 52 Nm</checkListItemLimits>
          </checkListItem>
          <checkListItem>
            <para>Green system supply and return couplings tightened.</para>
            <checkListItemLimits>Torque 34 Nm to 38 Nm</checkListItemLimits>
          </checkListItem>
          <checkListItem>
            <para>Yellow system supply and return couplings tightened.</para>
            <checkListItemLimits>Torque 34 Nm to 38 Nm</checkListItemLimits>
          </checkListItem>
          <checkListItem>
            <para>Electrical connectors 2027VC and 2028VC engaged and locked.</para>
            <checkListItemLimits>Coupling ring fully home</checkListItemLimits>
          </checkListItem>
          <checkListItem>
            <para>External leak check at operating pressure.</para>
            <checkListItemLimits>No leakage permitted</checkListItemLimits>
          </checkListItem>
          <checkListItem>
            <para>Slat position drift measured against the rigging position.</para>
            <checkListItemLimits>Less than 0.4 deg</checkListItemLimits>
          </checkListItem>
          <checkListItem applicRefId="app-1000">
            <para>Thermal blanket installed and all six fasteners engaged.</para>
            <checkListItemLimits>Visual</checkListItemLimits>
          </checkListItem>
          <checkListItem>
            <para>Slat system operational test done with no fault message.</para>
            <checkListItemLimits>Maintenance status page clear</checkListItemLimits>
          </checkListItem>
          <checkListItem>
            <para>Work area clear of tools and of loose articles.</para>
            <checkListItemLimits>Tool check complete</checkListItemLimits>
          </checkListItem>
        </checkListItems>
      </checkListInfo>
    </checkList>
  </content>
