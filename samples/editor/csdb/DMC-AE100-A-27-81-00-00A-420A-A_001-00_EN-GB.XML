<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dmodule>
<dmodule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.s1000d.org/S1000D_6/xml_schema_flat/fault.xsd">
  <identAndStatusSection>
    <dmAddress>
      <dmIdent>
        <dmCode modelIdentCode="AE100" systemDiffCode="A" systemCode="27" subSystemCode="8" subSubSystemCode="1" assyCode="00" disassyCode="00" disassyCodeVariant="A" infoCode="420" infoCodeVariant="A" itemLocationCode="A"/>
        <language languageIsoCode="en" countryIsoCode="GB"/>
        <issueInfo issueNumber="001" inWork="00"/>
      </dmIdent>
      <dmAddressItems>
        <issueDate year="2026" month="02" day="18"/>
        <dmTitle>
          <techName>Slat control and monitoring system</techName>
          <infoName>Fault isolation — SLAT SYS 1 FAULT</infoName>
        </dmTitle>
      </dmAddressItems>
    </dmAddress>
    <dmStatus issueType="new">
      <security securityClassification="01"/>
      <responsiblePartnerCompany enterpriseCode="U8025">
        <enterpriseName>AERALIS AEROSPACE</enterpriseName>
      </responsiblePartnerCompany>
      <originator enterpriseCode="U8025">
        <enterpriseName>AERALIS AEROSPACE — Technical Data</enterpriseName>
      </originator>
      <applic>
        <displayText>
          <simplePara>AE100-900 and AE100-1000, all aircraft</simplePara>
        </displayText>
      </applic>
      <qualityAssurance>
        <firstVerification verificationType="tabtop"/>
      </qualityAssurance>
    </dmStatus>
  </identAndStatusSection>
  <content>
    <faultIsolation>
      <faultDescr>
        <para>The maintenance status page shows the fault message <verbatimText>SLAT SYS 1 FAULT</verbatimText>
          together with the correlated message <verbatimText>SFCC1 (27CV1)</verbatimText>. The slat system
          continues to operate on the standby channel at half rate.</para>
        <para>Do this procedure after a flight in which the fault message was shown, or after the
          message is raised during a system test on the ground.</para>
      </faultDescr>
      <faultIsolationProcedure>
        <isolationProcedure>
          <preliminaryRqmts>
            <reqCondGroup>
              <reqCondDm>
                <reqCond>The aircraft electrical power is available.</reqCond>
                <dmRef>
                  <dmRefIdent>
                    <dmCode modelIdentCode="AE100" systemDiffCode="A" systemCode="24" subSystemCode="4" subSubSystemCode="1" assyCode="00" disassyCode="00" disassyCodeVariant="A" infoCode="861" infoCodeVariant="A" itemLocationCode="A"/>
                  </dmRefIdent>
                  <dmRefAddressItems>
                    <dmTitle>
                      <techName>Electrical power</techName>
                      <infoName>Energize the aircraft</infoName>
                    </dmTitle>
                  </dmRefAddressItems>
                </dmRef>
              </reqCondDm>
            </reqCondGroup>
            <reqSupportEquips>
              <supportEquipDescrGroup>
                <supportEquipDescr>
                  <name>Portable maintenance access terminal</name>
                  <identNumber>
                    <manufacturerCode>U8025</manufacturerCode>
                    <partAndSerialNumber>
                      <partNumber>98D45111000000</partNumber>
                    </partAndSerialNumber>
                  </identNumber>
                  <reqQuantity>1</reqQuantity>
                </supportEquipDescr>
              </supportEquipDescrGroup>
            </reqSupportEquips>
            <reqSupplies><noSupplies/></reqSupplies>
            <reqSpares><noSpares/></reqSpares>
            <reqSafety>
              <safetyRqmts>
                <warning>
                  <warningAndCautionPara>Make sure that the slat travel area is clear of persons and
                    equipment before you do a system test. The slats move without a warning when the
                    test is started.</warningAndCautionPara>
                </warning>
              </safetyRqmts>
            </reqSafety>
          </preliminaryRqmts>
          <isolationMainProcedure>
            <isolationStep id="stp-001">
              <isolationStepQuestion>
                <para>Do the SFCC 1 built-in test on the maintenance terminal. Is the fault message
                  <verbatimText>SFCC1 CHANNEL A</verbatimText> shown at the end of the test?</para>
              </isolationStepQuestion>
              <isolationStepAnswer nextActionRefId="stp-002">
                <isolationStepAnswerValue>YES</isolationStepAnswerValue>
                <para>The fault is inside the computer or on its power supply.</para>
              </isolationStepAnswer>
              <isolationStepAnswer nextActionRefId="stp-003">
                <isolationStepAnswerValue>NO</isolationStepAnswerValue>
                <para>The fault is in the position feedback or in the wiring.</para>
              </isolationStepAnswer>
            </isolationStep>
            <isolationStep id="stp-002">
              <isolationStepQuestion>
                <para>Examine the circuit breaker 4027GA on panel 121VU. Is the circuit breaker
                  tripped?</para>
              </isolationStepQuestion>
              <isolationStepAnswer nextActionRefId="stp-end">
                <isolationStepAnswerValue>YES</isolationStepAnswerValue>
                <correctiveAction>Reset the circuit breaker and do the slat system operational test.
                  If the circuit breaker trips again, replace the SFCC 1.</correctiveAction>
              </isolationStepAnswer>
              <isolationStepAnswer nextActionRefId="stp-end">
                <isolationStepAnswerValue>NO</isolationStepAnswerValue>
                <correctiveAction>Replace the SFCC 1 and do the slat system operational test.</correctiveAction>
              </isolationStepAnswer>
            </isolationStep>
            <isolationStep id="stp-003">
              <isolationStepQuestion>
                <para>Do a continuity check of the harness between connector 2027VC on the PCU and
                  connector 2101VC on the SFCC 1. Is the resistance of each conductor less than
                  1.5 ohm?</para>
              </isolationStepQuestion>
              <isolationStepAnswer nextActionRefId="stp-end">
                <isolationStepAnswerValue>YES</isolationStepAnswerValue>
                <correctiveAction>Replace the feedback position pick-off unit on the PCU output and
                  do the slat system operational test.</correctiveAction>
              </isolationStepAnswer>
              <isolationStepAnswer nextActionRefId="stp-end">
                <isolationStepAnswerValue>NO</isolationStepAnswerValue>
                <correctiveAction>Repair the harness between the two connectors and do the slat
                  system operational test.</correctiveAction>
              </isolationStepAnswer>
            </isolationStep>
            <isolationProcedureEnd id="stp-end">
              <para>Make sure that no fault message is shown on the maintenance status page and make
                an entry in the aircraft technical log.</para>
            </isolationProcedureEnd>
          </isolationMainProcedure>
          <closeRqmts>
            <reqCondGroup>
              <reqCondNoRef>
                <reqCond>Remove the maintenance terminal and close the access panels.</reqCond>
              </reqCondNoRef>
            </reqCondGroup>
          </closeRqmts>
        </isolationProcedure>
      </faultIsolationProcedure>
    </faultIsolation>
  </content>
</dmodule>
