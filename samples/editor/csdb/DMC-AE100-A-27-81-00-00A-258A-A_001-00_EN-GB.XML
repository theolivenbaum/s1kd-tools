  <content>
    <process>
      <para>This process drives a technician through the replacement of a slat actuation power
        control unit on an electronic device. The printed form below gives the same sequence with
        the branches written out, for use when no device is available.</para>
      <dmSeq>
        <dmNode id="nd-010" nodeIdent="ENTRY">
          <proceduralStep>
            <para>Confirm the reason for the removal: scheduled replacement, fault message, or
              accomplishment of service bulletin AE100-27-1042.</para>
          </proceduralStep>
          <dmNodeAlts>
            <dmNodeAlt altValue="Fault message" nextActionRefId="nd-020"/>
            <dmNodeAlt altValue="Scheduled or service bulletin" nextActionRefId="nd-030"/>
          </dmNodeAlts>
        </dmNode>
        <dmNode id="nd-020" nodeIdent="ISOLATE">
          <proceduralStep>
            <para>Do the fault isolation procedure for the reported message before you remove the
              unit. A unit that is removed without fault isolation is charged to the operator if the
              shop finds no fault.</para>
          </proceduralStep>
          <dmNodeAlts>
            <dmNodeAlt altValue="Fault confirmed on the unit" nextActionRefId="nd-030"/>
            <dmNodeAlt altValue="Fault elsewhere"/>
          </dmNodeAlts>
        </dmNode>
        <dmNode id="nd-030" nodeIdent="REMOVE">
          <proceduralStep>
            <para>Do the removal procedure. Record the serial number of the unit that is removed and
              the total flight hours of the aircraft.</para>
          </proceduralStep>
          <dmNodeAlts>
            <dmNodeAlt altValue="Removal complete" nextActionRefId="nd-040"/>
          </dmNodeAlts>
        </dmNode>
        <dmNode id="nd-040" nodeIdent="INSTALL">
          <proceduralStep>
            <para>Do the installation procedure with the replacement unit, then complete the
              post-installation check list.</para>
          </proceduralStep>
          <dmNodeAlts>
            <dmNodeAlt altValue="All check list items signed" nextActionRefId="nd-050"/>
            <dmNodeAlt altValue="An item cannot be signed" nextActionRefId="nd-040"/>
          </dmNodeAlts>
        </dmNode>
        <dmNode id="nd-050" nodeIdent="CLOSE">
          <proceduralStep>
            <para>Close the aircraft, make the technical log entry and report the replacement through
              the customer services portal.</para>
          </proceduralStep>
          <dmNodeAlts>
            <dmNodeAlt altValue="Complete"/>
          </dmNodeAlts>
        </dmNode>
      </dmSeq>
    </process>
  </content>
</dmodule>
