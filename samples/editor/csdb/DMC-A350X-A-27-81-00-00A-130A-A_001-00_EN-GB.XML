  <identAndStatusSection>
    <dmAddress>
      <dmIdent>
        <dmCode modelIdentCode="A350X" systemDiffCode="A" systemCode="27" subSystemCode="8" subSubSystemCode="1" assyCode="00" disassyCode="00" disassyCodeVariant="A" infoCode="130" infoCodeVariant="A" itemLocationCode="A"/>
        <language languageIsoCode="en" countryIsoCode="GB"/>
        <issueInfo issueNumber="002" inWork="00"/>
      </dmIdent>
      <dmAddressItems>
        <issueDate year="2026" month="01" day="30"/>
        <dmTitle>
          <techName>Slats and flaps</techName>
          <infoName>Abnormal procedure — slats jammed</infoName>
        </dmTitle>
      </dmAddressItems>
    </dmAddress>
    <dmStatus issueType="revised">
      <security securityClassification="01"/>
      <responsiblePartnerCompany enterpriseCode="U8025">
        <enterpriseName>AIRBUS S.A.S.</enterpriseName>
      </responsiblePartnerCompany>
      <originator enterpriseCode="U8025">
        <enterpriseName>AIRBUS S.A.S. — Flight Operations Support</enterpriseName>
      </originator>
      <applic>
        <displayText>
          <simplePara>A350X-900 and A350X-1000, all aircraft</simplePara>
        </displayText>
      </applic>
      <qualityAssurance>
        <secondVerification verificationType="onobject"/>
      </qualityAssurance>
    </dmStatus>
  </identAndStatusSection>
  <content>
    <crew>
      <crewRefCard>
        <title>Applicability and conditions</title>
        <para>This drill applies when the ECAM shows <verbatimText>F/CTL SLATS JAMMED</verbatimText>
          and the slat surfaces do not follow the lever position. The flaps are not affected and stay
          available for the approach.</para>
        <caution>
          <warningAndCautionPara>Do not move the flap and slat control lever again before the drill is
            complete. A second command can lock the wing tip brakes and remove the flap system as
            well.</warningAndCautionPara>
        </caution>
      </crewRefCard>
      <crewDrill>
        <title>Slats jammed — drill</title>
        <crewDrillStep>
          <crewDrillAction>FLAP LEVER</crewDrillAction>
          <crewDrillResponse>DO NOT MOVE</crewDrillResponse>
        </crewDrillStep>
        <crewDrillStep>
          <crewDrillAction>SPEED</crewDrillAction>
          <crewDrillResponse>MAINTAIN BELOW PLACARD</crewDrillResponse>
        </crewDrillStep>
        <crewDrillStep>
          <crewDrillAction>SLAT POSITION INDICATION</crewDrillAction>
          <crewDrillResponse>CHECK AND NOTE</crewDrillResponse>
          <note>
            <notePara>The slat position at the time of the jam determines the approach speed
              increment and the landing distance factor to be applied.</notePara>
          </note>
        </crewDrillStep>
        <crewDrillStep>
          <crewDrillAction>LANDING DISTANCE</crewDrillAction>
          <crewDrillResponse>APPLY FACTOR 1.35</crewDrillResponse>
        </crewDrillStep>
        <crewDrillStep>
          <crewDrillAction>APPROACH SPEED</crewDrillAction>
          <crewDrillResponse>VREF + 15 KT</crewDrillResponse>
        </crewDrillStep>
        <crewDrillStep>
          <crewDrillAction>FOR LANDING</crewDrillAction>
          <crewDrillResponse>USE FLAP 3</crewDrillResponse>
          <crewDrillStep>
            <crewDrillAction>GO-AROUND THRUST</crewDrillAction>
            <crewDrillResponse>CONFIRM AVAILABLE</crewDrillResponse>
          </crewDrillStep>
          <crewDrillStep>
            <crewDrillAction>AUTOBRAKE</crewDrillAction>
            <crewDrillResponse>MEDIUM</crewDrillResponse>
          </crewDrillStep>
        </crewDrillStep>
      </crewDrill>
      <crewRefCard>
        <title>After landing</title>
        <para>Write the fault in the aircraft technical log with the slat position at the time of the
          jam and the ECAM messages that were shown. Maintenance action is required before the next
          flight.</para>
      </crewRefCard>
    </crew>
  </content>
</dmodule>
