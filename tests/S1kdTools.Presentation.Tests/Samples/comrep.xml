    <commonRepository>
      <warningRepository>
        <warningSpec warningIdentNumber="A350X-W-0001">
          <warningAndCautionPara>Make sure that the hydraulic systems are depressurized before you
            disconnect a hydraulic line. Hydraulic fluid at 206 bar (2988 psi) can cause injury to
            persons and damage to equipment.</warningAndCautionPara>
        </warningSpec>
        <warningSpec warningIdentNumber="A350X-W-0002">
          <warningAndCautionPara>Make sure that the slat and flap travel areas are clear of persons
            and equipment before a system test. The surfaces move without a warning when the test is
            started.</warningAndCautionPara>
        </warningSpec>
        <warningSpec warningIdentNumber="A350X-W-0014">
          <warningAndCautionPara>Do not touch the brake units after a landing until they have cooled.
            Surface temperatures of more than 300 °C can cause burns.</warningAndCautionPara>
        </warningSpec>
      </warningRepository>
      <cautionRepository>
        <cautionSpec cautionIdentNumber="A350X-C-0007">
          <warningAndCautionPara>Do not let a line replaceable unit hang on its hydraulic or
            electrical connections. Damage to the couplings and to the connector shells can
            occur.</warningAndCautionPara>
        </cautionSpec>
        <cautionSpec cautionIdentNumber="A350X-C-0011">
          <warningAndCautionPara>Do not use a solvent on a painted surface of the belly fairing.
            Damage to the protective coating can occur.</warningAndCautionPara>
        </cautionSpec>
      </cautionRepository>
