<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dmodule>
<dmodule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.s1000d.org/S1000D_6/xml_schema_flat/brex.xsd">
  <identAndStatusSection>
    <dmAddress>
      <dmIdent>
        <dmCode modelIdentCode="A350X" systemDiffCode="A" systemCode="00" subSystemCode="0" subSubSystemCode="0" assyCode="0000" disassyCode="00" disassyCodeVariant="A" infoCode="022" infoCodeVariant="A" itemLocationCode="D"/>
        <language languageIsoCode="en" countryIsoCode="GB"/>
        <issueInfo issueNumber="006" inWork="00"/>
      </dmIdent>
      <dmAddressItems>
        <issueDate year="2026" month="01" day="12"/>
        <dmTitle>
          <techName>A350X technical publications</techName>
          <infoName>Business rules exchange</infoName>
        </dmTitle>
      </dmAddressItems>
    </dmAddress>
    <dmStatus issueType="revised">
      <security securityClassification="01"/>
      <responsiblePartnerCompany enterpriseCode="U8025">
        <enterpriseName>AIRBUS S.A.S.</enterpriseName>
      </responsiblePartnerCompany>
      <originator enterpriseCode="U8025">
        <enterpriseName>AIRBUS S.A.S. — Data Management</enterpriseName>
      </originator>
      <applic>
        <displayText><simplePara>All A350X data modules</simplePara></displayText>
      </applic>
      <qualityAssurance>
        <secondVerification verificationType="tabtop"/>
      </qualityAssurance>
    </dmStatus>
  </identAndStatusSection>
  <content>
    <brex>
      <contextRules rulesContext="A350X common">
        <structureObjectRuleGroup>
          <structureObjectRule>
            <objectPath allowedObjectFlag="2">//dmodule/identAndStatusSection/dmStatus/security</objectPath>
            <objectUse>The security classification must be stated on every data module. Use 01 for
              data that may be released to operators and 02 for data restricted to the design
              organization and its partners.</objectUse>
            <objectValue valueAllowed="01">Unclassified</objectValue>
            <objectValue valueAllowed="02">Restricted</objectValue>
          </structureObjectRule>
          <structureObjectRule>
            <objectPath allowedObjectFlag="1">//dmodule/identAndStatusSection/dmStatus/responsiblePartnerCompany/enterpriseName</objectPath>
            <objectUse>The responsible partner company name is mandatory and must be spelled exactly
              as it is registered in the supplier list.</objectUse>
          </structureObjectRule>
          <structureObjectRule>
            <objectPath allowedObjectFlag="0">//dmodule//para/@changeType[. = 'delete']</objectPath>
            <objectUse>Deleted content is removed at issue, not marked. Do not use the delete change
              type in a released data module.</objectUse>
          </structureObjectRule>
          <structureObjectRule>
            <objectPath allowedObjectFlag="2">//dmodule//dmCode/@modelIdentCode</objectPath>
            <objectUse>Only the model identification codes of this programme may be referenced from a
              A350X data module.</objectUse>
            <objectValue valueAllowed="A350X">A350X airframe</objectValue>
            <objectValue valueAllowed="S1000D">Specification-supplied data modules</objectValue>
          </structureObjectRule>
          <structureObjectRule>
            <objectPath allowedObjectFlag="1">//dmodule/content//warning/warningAndCautionPara</objectPath>
            <objectUse>A warning must state the hazard and its consequence in that order, in no more
              than three sentences.</objectUse>
          </structureObjectRule>
          <structureObjectRule>
            <objectPath allowedObjectFlag="2">//dmodule//issueDate/@year</objectPath>
            <objectUse>The issue date must be inside the life of the programme.</objectUse>
            <objectValue valueAllowed="2016">Programme start</objectValue>
            <objectValue valueAllowed="2027">Current planning horizon</objectValue>
          </structureObjectRule>
        </structureObjectRuleGroup>
      </contextRules>
      <notationRules>
        <notationRule>
          <notationName>png</notationName>
          <objectUse>Raster illustrations are delivered as PNG at 300 dpi or better.</objectUse>
        </notationRule>
        <notationRule>
          <notationName>cgm</notationName>
          <objectUse>Vector illustrations are delivered as CGM version 4 profile ATA.</objectUse>
        </notationRule>
      </notationRules>
    </brex>
  </content>
</dmodule>
