  <content>
    <wiringFields>
      <para>These are the fields the A350X wiring data uses. A wiring data module must populate every
        field marked mandatory; a field marked optional may be left out when the value is not known
        at the time of delivery.</para>
      <wiringField fieldIdent="WIRE-ID" fieldFormat="AAAAAA-ANN" fieldUse="Mandatory">
        <fieldName>Wire identification, unique in the aircraft</fieldName>
      </wiringField>
      <wiringField fieldIdent="GAUGE" fieldFormat="NN" fieldUse="Mandatory">
        <fieldName>Wire gauge, American wire gauge</fieldName>
      </wiringField>
      <wiringField fieldIdent="WIRE-TYPE" fieldFormat="AAAAA" fieldUse="Mandatory">
        <fieldName>Insulation and construction standard</fieldName>
      </wiringField>
      <wiringField fieldIdent="FROM" fieldFormat="AAAANN-ANN" fieldUse="Mandatory">
        <fieldName>Connector and contact at the origin end</fieldName>
      </wiringField>
      <wiringField fieldIdent="TO" fieldFormat="AAAANN-ANN" fieldUse="Mandatory">
        <fieldName>Connector and contact at the destination end</fieldName>
      </wiringField>
      <wiringField fieldIdent="LENGTH" fieldFormat="N.NN m" fieldUse="Optional">
        <fieldName>Cut length, including the service loop</fieldName>
      </wiringField>
      <wiringField fieldIdent="HARNESS" fieldFormat="NNANNN" fieldUse="Mandatory">
        <fieldName>Harness the wire is routed in</fieldName>
      </wiringField>
      <wiringField fieldIdent="SHIELD" fieldFormat="A" fieldUse="Optional">
        <fieldName>Shield termination end, F for from, T for to, B for both</fieldName>
      </wiringField>
    </wiringFields>
  </content>
